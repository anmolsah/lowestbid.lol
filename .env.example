# ==============================================
# lowestbid.lol - Environment Configuration
# ==============================================

# Dodo Payments API Configuration
# Get your API key from Dodo Payments Dashboard -> Developer -> API Keys
# Test keys start with 'test_'
DODO_PAYMENTS_API_KEY=

# Webhook Secret from Dodo Payments Dashboard -> Developer -> Webhooks
# Format typically 'whsec_...'
DODO_PAYMENTS_WEBHOOK_KEY=

# Product ID from Dodo Payments Catalog -> One-Time Product (Pay What You Want enabled)
# e.g., 'pdt_01J...'
DODO_PAYMENTS_PRODUCT_ID=

# Environment mode: 'test_mode' for development/sandbox, 'live_mode' for production
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Application Base URL (for return_url and metadata redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
